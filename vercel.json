{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "docs",
  "functions": {
    "api/*.js": { "maxDuration": 60 }
  },
  "headers": [
    { "source": "/data/(.*).json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
